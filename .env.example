# Required: NVIDIA API key for the Nemotron endpoint (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=agent_db

# Host ports (change if something else is already listening)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Seals AI-employee credentials at rest (change for anything beyond local dev)
SECRET_KEY=change-me
# How many project runs may execute at once
RUN_CONCURRENCY=2
# Tool calls one employee gets per ticket. Raise it for bigger tickets.
MAX_AGENT_STEPS=24
# Ceiling on passes over the board; a run also stops once a pass finishes nothing.
MAX_RUN_PASSES=4

# --- people signing in -----------------------------------------------------
# Signs access tokens. Falls back to SECRET_KEY so a fresh install works, but
# they should differ: one seals data at rest, the other mints identity.
JWT_SECRET=
# On everywhere that is not localhost. Cookies without it travel in the clear.
COOKIE_SECURE=false
# Set only when the browser and the API are on different hosts.
COOKIE_DOMAIN=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Consecutive failures before one account stops answering, and for how long.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
